# LOCAL DEVELOPMENT: leave DATABASE_URL empty/unset -> uses SQLite file backend/shipyard.db
# (created automatically, nothing to install)
#
# PRODUCTION (Render): set DATABASE_URL to the Render PostgreSQL Internal Database URL
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: change the local SQLite file location
# SQLITE_PATH=shipyard.db

# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Authentication (REQUIRED for production)
# SECRET_KEY signs login tokens - use a long random string
# SECRET_KEY=change-me
# First admin account, created automatically when the users table is empty
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=choose-a-strong-password
